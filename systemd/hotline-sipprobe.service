[Unit]
Description=hotline-call SIP probe (captures what a SIP client emits in REGISTER)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/data/hotline-call
Environment=PYTHONPATH=%h/data/hotline-call/src
ExecStart=%h/data/hotline-call/.venv/bin/python -m hotline_call.sipprobe \
  --host 100.72.2.62 --port 5060 \
  --capture %h/data/hotline-call/sip-capture.txt
Restart=always
RestartSec=5
# The same reason hotlined has it: this must never take a tmux server -- and
# therefore every live Claude session -- down with it. See hotline's handoff.
KillMode=process

[Install]
WantedBy=default.target
